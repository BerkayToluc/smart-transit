# Bu dosyayı "frontend/.env.local" adıyla kopyalayıp değerleri doldurun.
# ".env.local" git'e eklenmez.

# Google Maps JavaScript API anahtarı (tarayıcıya gömülür; Google Cloud'da
# alan adı/HTTP referrer kısıtlaması koymayı unutmayın)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# FastAPI backend adresi. Boş bırakılırsa http://localhost:8000 kullanılır.
# Not: Bu değer build sırasında koda gömülür; değiştirince `npm run dev`'i
# yeniden başlatın.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Next.js API route'unun (app/api/hatlar) kullandığı Neon.tech bağlantı adresi
# (yalnızca sunucuda okunur, tarayıcıya gitmez)
DATABASE_URL=
